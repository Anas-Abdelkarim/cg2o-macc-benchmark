# generated by the build scripts
build/
install/
example/

# third-party sources (cloned or unpacked by scripts/build_externals.sh); see externals/README.md
externals/*
!externals/README.md
!externals/COLCON_IGNORE

# experiment output
results/
!results/.gitkeep

# local notes, logs and editor files (never published)
doc_local/
*.log
debug.txt
.vscode/
.cache/
.DS_Store
/umfpack_linear_debug

# Python
__pycache__/
*.pyc
.venv-tuning/
*.egg-info/
.ruff_cache/
.pytest_cache/

# archives that were unpacked into the tree
*.zip
